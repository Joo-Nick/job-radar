# ── DB ────────────────────────────────────────────
# 로컬: file:./.pglite  (PGlite, 설치 불필요)
# 배포: Neon 연결 문자열 postgresql://...
DATABASE_URL=file:./.pglite

# ── 인증 (Better Auth) ────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console → OAuth 클라이언트 (리디렉션 URI: <BETTER_AUTH_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 데이터 소스 ───────────────────────────────────
# data.go.kr "재정경제부_공공기관 채용정보 조회서비스" 활용신청 → 일반 인증키(Decoding)
ALIO_SERVICE_KEY=

# ── 텔레그램 ──────────────────────────────────────
# @BotFather 로 봇 생성
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 웹훅 검증용 임의 문자열 (setWebhook 의 secret_token 과 동일하게)
TELEGRAM_WEBHOOK_SECRET=

# ── 크론 ──────────────────────────────────────────
# /api/cron/* 호출 시 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
